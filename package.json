{
  "name": "nextjs-using-mui-react-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --pretty --noEmit",
    "format": "prettier --write .",
    "postbuild": "next-sitemap",
    "prepare": "husky"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "yarn run type-check"
    }
  },
  "lint-staged": {
    "*.@(ts|tsx)": [
      "yarn lint",
      "yarn format"
    ]
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "mobx": "^7.1.0",
    "mobx-persist": "^0.4.1",
    "mobx-react": "^10.0.2",
    "mobx-react-lite": "^5.1.0",
    "next": "^16.4.2",
    "next-sitemap": "^4.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "stylis": "^4.4.0",
    "stylis-plugin-rtl": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/stylis": "^4.2.7",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
